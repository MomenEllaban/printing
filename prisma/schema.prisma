generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String                 @id @default(cuid())
  email       String?                @unique
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  connections GoogleDriveConnection[]
  files       FileMetadata[]
  folders     FolderMetadata[]
  favorites   Favorite[]
  auditLogs   AuditLog[]
}

model GoogleDriveConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  accountEmail    String?
  accessToken     String
  refreshToken    String?
  tokenExpiry     DateTime?
  scope           String?
  rootFolderId    String?
  connectionStatus String   @default("connected")
  lastConnectedAt DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([connectionStatus])
}

model FileMetadata {
  id                String   @id @default(cuid())
  userId            String
  googleDriveFileId String   @unique
  name              String
  mimeType          String
  extension         String?
  size              BigInt   @default(0)
  parentFolderId    String?
  modifiedTime      DateTime?
  webViewLink       String?
  thumbnailLink     String?
  isFolder          Boolean  @default(false)
  lastSyncedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentFolderId])
  @@index([mimeType])
  @@index([name])
  @@index([modifiedTime])
}

model FolderMetadata {
  id                  String   @id @default(cuid())
  userId              String
  googleDriveFolderId String   @unique
  name                String
  parentFolderId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentFolderId])
}

model Favorite {
  id                String   @id @default(cuid())
  userId            String
  googleDriveFileId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleDriveFileId])
  @@index([userId])
}

model ApplicationSetting {
  key       String   @id
  value     Json
  category  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  status    String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
