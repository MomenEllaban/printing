# Neon PostgreSQL (pooled connection for the app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon direct connection (used by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Google OAuth / Drive
GOOGLE_ACCOUNT_EMAIL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: show generated demo files while Drive is not connected ("1" or "true")
DEMO_MODE="1"

# 48+ random bytes, base64url. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# 32 random bytes as hex (64 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
